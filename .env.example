# Optional settings for the local Docker launcher. Copy this file to .env.
# Keep the original database password when reusing an existing data volume.
MYSQL_ROOT_PASSWORD=123456
ISD_HTTP_PORT=8081
DEEPSEEK_API_KEY=local-placeholder
# Optional Maven mirror for slow downloads, e.g. https://maven.aliyun.com/repository/public
MAVEN_MIRROR_URL=
# Local Docker generates a persistent master key automatically when this is empty.
# Production: supply the same Base64-encoded random 32-byte key to every replica.
ISD_AI_MASTER_KEY=
# Comma-separated HTTPS origins approved for CUSTOM model configurations (no paths).
ISD_AI_ALLOWED_ORIGINS=
