# 前端依赖与构建产物（构建产物由 npm run build 生成，不进仓库）
web/node_modules/
src/main/resources/static/
# 单测覆盖率产物（npm run test:coverage 生成）
web/coverage/

# 本地自签证书（deploy/certs/generate.ps1 生成，只提交脚本）
deploy/certs/*.crt
deploy/certs/*.key
deploy/certs/*.pem
deploy/certs/*.p12

# Playwright E2E artifacts
web/playwright-report/
web/test-results/
